# Copier ce fichier en ".env" à la racine du projet pour lancer en profil dev.
# ".env" est ignoré par git — ce fichier .env.dev est un template versionné, sans secret réel.

SPRING_PROFILES_ACTIVE=dev

# --- Base de données PostgreSQL (dev) ---
DB_URL=jdbc:postgresql://localhost:5432/mstanshop_dev
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- JWT ---
JWT_SECRET=change-me
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# --- Upload ---
UPLOAD_DIR=uploads

# --- Frontend ---
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_OAUTH_REDIRECT_URL=http://localhost:5173/oauth2/redirect

# --- SMTP (ex: sandbox Mailtrap) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=mstashop
SMTP_PASSWORD=change-me
MAIL_FROM=no-reply@mstan-shop.com

# --- OAuth2 Google (optionnel en dev) ---
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# --- Seed admin ---
SEED_ADMIN_EMAIL=admin@mstan-shop.com
SEED_ADMIN_PASSWORD=change-me

# --- WhatsApp (Genuka) ---
GENUKA_API_KEY=change-me
GENUKA_CONNECTION_ID=change-me
GENUKA_WEBHOOK_SECRET=change-me

# --- Paiement mobile (CamPay) ---
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_API_KEY=change-me
CAMPAY_WEBHOOK_KEY=change-me

# --- Stockage objets (Cloudflare R2) ---
R2_ENDPOINT=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET=change-me
R2_PUBLIC_BASE_URL=change-me
