# Copier ce fichier en ".env" à la racine du projet pour lancer en profil prod.
# ".env" est ignoré par git — ne jamais committer de vraies valeurs de secrets.
# En prod réelle, préférer l'injection de ces variables par la plateforme d'hébergement
# (secrets manager, variables d'environnement du conteneur, etc.) plutôt qu'un fichier .env.

SPRING_PROFILES_ACTIVE=prod

# --- Base de données PostgreSQL (prod) ---
DB_URL=jdbc:postgresql://localhost:5432/mstanshop
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- JWT ---
JWT_SECRET=change-this-super-secret-key-min-256-bits-long-in-production
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# --- Upload ---
UPLOAD_DIR=uploads

# --- Frontend ---
FRONTEND_BASE_URL=https://www.mstan-shop.com
FRONTEND_OAUTH_REDIRECT_URL=https://www.mstan-shop.com/oauth2/redirect

# --- SMTP ---
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
MAIL_FROM=no-reply@mstan-shop.com

# --- OAuth2 Google ---
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# --- Seed admin ---
SEED_ADMIN_EMAIL=admin@mstan-shop.com
SEED_ADMIN_PASSWORD=change-me

# --- Serveur ---
SERVER_PORT=8080

# --- WhatsApp (Genuka) ---
GENUKA_API_KEY=change-me
GENUKA_CONNECTION_ID=change-me
GENUKA_WEBHOOK_SECRET=change-me

# --- Paiement mobile (CamPay) ---
CAMPAY_BASE_URL=https://www.campay.net/api
CAMPAY_API_KEY=change-me
CAMPAY_WEBHOOK_KEY=change-me

# --- Stockage objets (Cloudflare R2) ---
R2_ENDPOINT=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET=change-me
R2_PUBLIC_BASE_URL=change-me
