# Copier ce fichier en ".env" à la racine du projet pour lancer en profil dev.
# ".env" est ignoré par git — ce fichier .env.dev est un template versionné, sans secret réel.

SPRING_PROFILES_ACTIVE=

# --- Base de données PostgreSQL (dev) ---
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# --- JWT ---
JWT_SECRET=
JWT_ACCESS_EXPIRATION=
JWT_REFRESH_EXPIRATION=

# --- Upload ---
UPLOAD_DIR=

# --- Frontend ---
FRONTEND_BASE_URL=
FRONTEND_OAUTH_REDIRECT_URL=

# --- SMTP (ex: sandbox Mailtrap) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# --- OAuth2 Google (optionnel en dev) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Seed admin ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- WhatsApp (Genuka) ---
GENUKA_API_KEY=
GENUKA_CONNECTION_ID=
GENUKA_WEBHOOK_SECRET=

# --- Paiement mobile (CamPay) ---
CAMPAY_BASE_URL=
CAMPAY_API_KEY=
CAMPAY_WEBHOOK_KEY=

# --- Stockage objets (Cloudflare R2) ---
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
